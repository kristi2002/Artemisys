# Copia questi valori nella tab "Environment Variables" di Coolify.
# NON committare il file .env reale.

# Database
DB_NAME=artemisys
DB_USER=artemisys
DB_PASSWORD=cambia-questa-password-robusta
DB_ROOT_PASSWORD=cambia-anche-questa-root

# Metti a 1 SOLO per debug temporaneo (mostra gli errori a schermo). In produzione: 0
APP_DEBUG=0

# ─────────────────────────────────────────────────────────────────────────────
# Indirizzo pubblico dell'app
# ─────────────────────────────────────────────────────────────────────────────
# Serve a costruire i link assoluti dentro le email (recupero password, avvisi).
# Senza questo valore i link non funzionano quando l'invio parte da CLI/cron.
APP_URL=https://artemisys.testdemo.it

# ─────────────────────────────────────────────────────────────────────────────
# Email
# ─────────────────────────────────────────────────────────────────────────────
# Interruttore generale: finche' vale 0 l'app non spedisce nulla.
MAIL_ENABLED=1

# 1 = scrive le email nel log invece di spedirle. Utile in locale per provare
# i flussi senza credenziali SMTP. In produzione: 0
MAIL_LOG_ONLY=0

# --- Trasporto SMTP ---
# Gmail:  smtp.gmail.com : 587 (tls)
# Brevo:  smtp-relay.brevo.com : 587 (tls)
# Mailgun: smtp.eu.mailgun.org : 587 (tls)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls

# --- Credenziali ---
# Con Gmail NON va la password dell'account: serve una "Password per le app",
# che si genera solo dopo aver attivato la verifica in due passaggi.
#   Account Google -> Sicurezza -> Verifica in due passaggi -> Password per le app
# E' una stringa di 16 caratteri; qui va scritta senza spazi.
MAIL_USERNAME=segreteria@esempio.it
MAIL_PASSWORD=xxxxxxxxxxxxxxxx

# --- Identita' del mittente ---
# ATTENZIONE: con un account Gmail gratuito il MAIL_FROM deve coincidere con
# MAIL_USERNAME (o con un alias verificato in Gmail: Impostazioni -> Account ->
# "Invia messaggi come"). Se metti un indirizzo diverso, Google lo riscrive
# comunque con quello reale.
MAIL_FROM=segreteria@esempio.it
MAIL_FROM_NAME=Moascuola

# Dove finiscono le risposte degli utenti. Puo' essere diverso dal mittente:
# e' il modo corretto per far arrivare le risposte alla casella della scuola.
MAIL_REPLY_TO=segreteria@esempio.it

# Secondi di attesa massima verso il server SMTP. Volutamente basso: Apache
# qui ha solo 8 worker, un SMTP che non risponde non deve bloccarne uno.
MAIL_TIMEOUT=10
